; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="JUMP"
run/main_scene="res://scenes/main_menu.tscn"
; Phones with 90/120 Hz panels otherwise render at panel rate, doubling GPU
; cost for a game that only needs 60. Raise once the frame budget allows it.
run/max_fps=60
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/settings.gd"
Stats="*res://scripts/stats.gd"
Audio="*res://scripts/audio.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
; "viewport" renders at 720x1280 and upscales, instead of rendering the whole
; glow/HDR pipeline at the phone's native resolution (often 1080x2400+).
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom_font="res://fonts/Chillax-Regular.otf"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[input_devices]

sensors/enable_accelerometer=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
